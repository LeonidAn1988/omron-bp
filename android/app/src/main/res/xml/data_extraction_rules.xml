<?xml version="1.0" encoding="utf-8"?>
<!--
    Что происходит с дневником при копировании и переносе.

    Раздельно, потому что это два разных события с разной ценой.

    **Облачная копия — запрещена целиком.** Android отправляет данные приложения в
    облако Google без спроса и без уведомления. Приложение обещает, что данные не
    покидают устройство, и на этом же обещании держится его правовое положение:
    пока данные никуда не уходят, обработки с нашей стороны нет. Копия шифруется
    ключом от блокировки экрана, но устройство она всё равно покидает.

    `allowBackup="false"` в манифесте это уже запрещает, однако на телефонах части
    производителей флаг закрывает только облако и не закрывает перенос. Поэтому
    правила заданы явно, а не оставлены на усмотрение прошивки.

    **Перенос на новый телефон — разрешён, и это осознанно.** Здесь данные идут
    между двумя устройствами одного человека, минуя чужие серверы. А главное,
    сейчас это единственный путь, которым дневник переживает смену телефона:
    автоматических копий на Android нет (система не даёт писать в файл, доступный
    человеку, без Storage Access Framework), и остаётся ручная отправка копии,
    про которую легко забыть.

    Запретить перенос значило бы ради буквального прочтения обещания лишить
    человека единственной страховки. Дневник давления за годы дороже.

    Ключ сопряжения с прибором переносится вместе со всем остальным — без него
    новый телефон не сможет читать память тонометра, и человеку пришлось бы
    сопрягать его заново.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>

    <device-transfer>
        <include domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
